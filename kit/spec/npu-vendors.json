    "intel": {
      "server": "OpenVINO Model Server",
      "version": "2026.4.1",
      "arch": "x64",
      "generations": {
        "meteor-lake": {
          "label": "Core Ultra Series 1, Meteor Lake (NPU 3720)",
          "supported": true,
          "verified": false
        },
        "arrow-lake": {
          "label": "Core Ultra 200H/U, Arrow Lake (NPU 3720)",
          "supported": true,
          "verified": false
        },
        "lunar-lake": {
          "label": "Core Ultra 200V, Lunar Lake (NPU 4)",
          "supported": true,
          "verified": false
        },
        "panther-lake": {
          "label": "Core Ultra Series 3, Panther Lake (NPU 5)",
          "supported": true,
          "verified": false
        }
      },
      "driverMin": "32.0.100.3104",
      "requires": [
        "vcredist-x64"
      ],
      "download": {
        "file": "ovms_windows_2026.4.1_python_on.zip",
        "url": "https://github.com/openvinotoolkit/model_server/releases/download/v2026.4.1/ovms_windows_2026.4.1_python_on.zip",
        "size": 139758672,
        "sha256": "aa79a0ae3b858356ba550978e397a8e8876a9d2706ffe4041b1dfd3f32cb8ce4"
      },
      "install": {
        "kind": "zip",
        "into": "{tools}\\servers\\ovms-2026.4.1",
        "exe": "{tools}\\servers\\ovms-2026.4.1\\ovms.exe"
      },
      "port": 18183,
      "serve": [
        "--rest_port",
        "{port}",
        "--rest_bind_address",
        "127.0.0.1",
        "--source_model",
        "{model}",
        "--model_repository_path",
        "{tools}\\models\\openvino",
        "--task",
        "text_generation",
        "--target_device",
        "NPU",
        "--max_prompt_len",
        "1536",
        "--cache_dir",
        "{tools}\\models\\openvino\\.npu-cache"
      ],
      "env": {
        "PYTHONHOME": "{tools}\\servers\\ovms-2026.4.1\\python",
        "PATH": "{tools}\\servers\\ovms-2026.4.1;{tools}\\servers\\ovms-2026.4.1\\python;{tools}\\servers\\ovms-2026.4.1\\python\\Scripts;%PATH%"
      },
      "models": [
        {
          "id": "OpenVINO/Qwen3-4B-int4-ov",
          "kinds": [
            "chat"
          ],
          "pull": [
            "--pull",
            "--source_model",
            "OpenVINO/Qwen3-4B-int4-ov",
            "--model_repository_path",
            "{tools}\\models\\openvino",
            "--task",
            "text_generation"
          ],
          "size": 2430000000,
          "licence": "Qwen3-4B: Apache-2.0; OpenVINO's INT4 export carries the base model's licence"
        }
      ],
      "maxContextTokens": 1536,
      "caps": {
        "chat": 1536
      },
      "timeouts": {
        "requestBaseMs": 30000,
        "requestPerTokenMs": 600,
        "coldLoadMs": 180000
      },
      "quirks": [],
      "recycle": false,
      "embeddings": "none on the NPU yet (OpenVINO documents embeddings on the processor and graphics only): they go to the graphics card or the processor",
      "vision": "none on the NPU yet: OpenVINO's Qwen3-VL-4B INT4 build is asymmetric, which the NPU doesn't take; vision goes to the graphics card or the processor",
      "licence": "OpenVINO Model Server: Apache-2.0",
      "notes": "A zip, unpacked into the tools home: no installer, no administrator. It needs the Microsoft Visual C++ Redistributable (x64), which an administrator installs once, and Intel's NPU driver 32.0.100.3104 or later. It serves the OpenAI routes at /v1 (and the older /v3), source-checked at v2026.4.1. The NPU compiles a model on first load (minutes), cached in --cache_dir. Its zip wraps everything in an ovms folder, which setup unpacks into ovms-2026.4.1; its Python (for chat templates) needs PYTHONHOME and PATH, which the entry's env gives (its setupvars script does the same)."
    },
