+
+// Castellan: is the merger asked for on the NPU (its device, or AUTO's first priority)? CASTELLAN_NPU_MERGER=0 says no.
+bool castellan_merger_on_npu(const std::string& device, const ov::AnyMap& properties) {
+    const char* off = std::getenv("CASTELLAN_NPU_MERGER");
+    if (off && std::string(off) == "0") {
+        return false;
+    }
+    if (device == "NPU") {
+        return true;
+    }
+    if (device.rfind("AUTO", 0) != 0) {
+        return false;
+    }
+    auto it = properties.find(ov::device::priorities.name());
+    return it != properties.end() && it->second.as<std::string>().rfind("NPU", 0) == 0;
+}
+
+// Castellan: the patch counts the NPU's mergers are compiled at, ascending: CASTELLAN_NPU_MERGER_PATCHES
+// (comma-separated), else 784 and 1600, a 448 px square and a 640 px one. 3136, an 896 px square, hangs the NPU 3720
+// (ZE_RESULT_ERROR_DEVICE_LOST), and agreement with the processor falls as the count grows (2304: cosine 0.997).
+std::vector<size_t> castellan_npu_merger_patches() {
+    std::vector<size_t> patches;
+    const char* given = std::getenv("CASTELLAN_NPU_MERGER_PATCHES");
+    std::stringstream list(given ? given : "784,1600");
+    for (std::string item; std::getline(list, item, ',');) {
+        const size_t n = std::strtoull(item.c_str(), nullptr, 10);
+        if (n > 0 && n % 4 == 0) {
+            patches.push_back(n);
+        }
+    }
+    std::sort(patches.begin(), patches.end());
+    patches.erase(std::unique(patches.begin(), patches.end()), patches.end());
+    return patches;
+}
+
+// Castellan: how long the processor's merger is kept after its last use, CASTELLAN_CPU_MERGER_IDLE_S, else 60 s; 0 keeps it.
+std::chrono::seconds castellan_cpu_merger_idle() {
+    const char* given = std::getenv("CASTELLAN_CPU_MERGER_IDLE_S");
+    return std::chrono::seconds(given ? std::strtoll(given, nullptr, 10) : 60);
+}
+
+bool castellan_has_input(const std::shared_ptr<ov::Model>& model, const std::string& name) {
+    for (const auto& input : model->inputs()) {
+        if (input.get_names().count(name)) {
+            return true;
+        }
+    }
+    return false;
+}
