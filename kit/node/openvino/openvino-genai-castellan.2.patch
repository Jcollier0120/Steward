+void InputsEmbedderQwen2VL::castellan_reap() {
+    std::unique_lock<std::mutex> lock(m_castellan_cpu_merger_mutex);
+    while (!m_castellan_stop) {
+        if (!m_ireq_queue_vision_embeddings_merger) {
+            m_castellan_cpu_merger_cv.wait(lock);
+            continue;
+        }
+        const auto due = m_castellan_cpu_merger_used + m_castellan_cpu_merger_idle;
+        if (std::chrono::steady_clock::now() < due) {
+            m_castellan_cpu_merger_cv.wait_until(lock, due);
+            continue;
+        }
+        // Its requests hold its compiled model: with them gone, so is the model.
+        m_ireq_queue_vision_embeddings_merger.reset();
+        if (utils::env_setup_for_print_debug_info()) {
+            std::cout << "Castellan: the processor's merger freed, " << m_castellan_cpu_merger_idle.count() << " s after its last use" << std::endl;
