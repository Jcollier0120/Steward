+
+void release_mapped_file_pages(const char* model_path) {
+#if defined(_WIN32)
+    if (!model_path) return;
+    const std::string path(model_path);
+    const size_t      cut  = path.find_last_of("/\\");
+    const std::string base = cut == std::string::npos ? path : path.substr(cut + 1);
+    const int         n    = MultiByteToWideChar(CP_UTF8, 0, base.c_str(), -1, nullptr, 0);
+    if (n <= 1) return;
+    std::wstring want(static_cast<size_t>(n - 1), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, base.c_str(), -1, want.data(), n);
+    want.insert(want.begin(), L'\\');
+
+    SYSTEM_INFO info;
+    GetSystemInfo(&info);
+    size_t                   released = 0;
+    MEMORY_BASIC_INFORMATION mbi{};
+    for (auto* at = static_cast<char*>(info.lpMinimumApplicationAddress);
+         at < static_cast<char*>(info.lpMaximumApplicationAddress);
+         at = static_cast<char*>(mbi.BaseAddress) + mbi.RegionSize) {
+        if (VirtualQuery(at, &mbi, sizeof(mbi)) != sizeof(mbi)) break;
+        if (mbi.State != MEM_COMMIT || mbi.Type != MEM_MAPPED) continue;
+        wchar_t     name[1024];
+        const DWORD len = K32GetMappedFileNameW(GetCurrentProcess(), mbi.BaseAddress, name, 1024);
+        if (len < want.size() || _wcsicmp(name + len - want.size(), want.c_str()) != 0) continue;
+        // The view isn't locked, so this only takes its pages out of the working set.
+        VirtualUnlock(mbi.BaseAddress, mbi.RegionSize);
+        released += mbi.RegionSize;
+    }
+    if (released) {
+        GENIEX_LOG_INFO("[Castellan] {} MB of the mapped model file left the working set", released >> 20);
+    }
+#else
+    (void)model_path;
+#endif
+}
